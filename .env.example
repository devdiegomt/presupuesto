# Copiar a .env.local (que está en .gitignore) y completar.
#
# Proyecto Supabase propio de presupuesto. Dashboard → Project Settings → API.
# La anon key es pública por diseño: lo que protege los datos es RLS sobre
# sync_records (user_id = auth.uid()), no el secreto de la key.
#
# El esquema está versionado en supabase/schema.sql.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
